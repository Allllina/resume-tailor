# Resume Tailor — harness backend configuration
# ────────────────────────────────────────────────────────────────────
# 1. Copy:    cp .env.example .env
# 2. Set:     HARNESS_ANTHROPIC_API_KEY = your sk-ant-... key
# 3. Run:     uvicorn harness.api.main:app --reload --port 8001
#
# Out of the box this connects DIRECTLY to the Anthropic API. If you
# prefer a local OpenAI-compatible proxy (LiteLLM, claude-max-api,
# etc.), see the OpenAI block below.
# ────────────────────────────────────────────────────────────────────

# ──── LLM provider (REQUIRED) ────
HARNESS_LLM_PROVIDER=anthropic

# ──── Anthropic — direct (recommended for self-hosted) ────
HARNESS_ANTHROPIC_API_KEY=sk-ant-...
HARNESS_ANTHROPIC_MODEL=claude-sonnet-4-6

# ──── OpenAI / OpenAI-compatible proxy (alternative) ────
# Uncomment and set HARNESS_LLM_PROVIDER=openai above to use this path.
# Useful for: claude-max-api, LiteLLM, DeepSeek, Kimi, 通义千问, etc.
# HARNESS_OPENAI_API_KEY=sk-...
# HARNESS_OPENAI_MODEL=gpt-4o-mini
# HARNESS_OPENAI_BASE_URL=
#   Common values:
#     http://localhost:3456/v1                            (claude-max-api local proxy)
#     https://api.deepseek.com/v1                         (DeepSeek)
#     https://api.moonshot.cn/v1                          (Kimi)
#     https://dashscope.aliyuncs.com/compatible-mode/v1   (通义千问)

# ──── Server ────
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8001

# ──── Wave 3: Discovery (auto-scrape JDs) ────
# Disabled by default — flip to true and set adapter keys when you want
# the harness to pull JDs from job boards.
HARNESS_DISCOVERY_ENABLED=false
HARNESS_DISCOVERY_INTERVAL_HOURS=6
HARNESS_DISCOVERY_ADAPTERS=jobspy,seek,adzuna,gradcracker,workingnomads,hiringcafe,golangjobs,ukvisajobs,tencent_doc
HARNESS_ADZUNA_APP_ID=
HARNESS_ADZUNA_APP_KEY=

# ──── Skill knowledge layer ────
# O*NET: free registration → https://services.onetcenter.org/developer/
# Provides occupational competency models for the resume optimizer skill.
HARNESS_ONET_USERNAME=
HARNESS_ONET_PASSWORD=
# JSearch: free 200 req/month → https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Enables live JD search (users don't need to paste JDs manually).
HARNESS_JSEARCH_API_KEY=

# ──── Wave 3: Auto-submit caps + intervals (seconds) ────
HARNESS_DAILY_CAP=50
HARNESS_LINKEDIN_SUBCAP=15
HARNESS_SUBMIT_INTERVAL_LINKEDIN=90
HARNESS_SUBMIT_INTERVAL_BOSS=60
HARNESS_SUBMIT_INTERVAL_WORKDAY=120
HARNESS_SUBMIT_INTERVAL_EMAIL=30
HARNESS_DEFAULT_SUBMIT_METHOD_LINKEDIN=userscript
HARNESS_DEFAULT_SUBMIT_METHOD_BOSS=userscript
HARNESS_DEFAULT_SUBMIT_METHOD_WORKDAY=selenium
HARNESS_DEFAULT_SUBMIT_METHOD_EMAIL=email
HARNESS_DEFAULT_SUBMIT_METHOD_GENERIC=manual

# ──── Wave 3: SMTP (email submit channel) ────
HARNESS_SMTP_HOST=
HARNESS_SMTP_PORT=587
HARNESS_SMTP_USER=
HARNESS_SMTP_PASSWORD=
HARNESS_SMTP_FROM=
